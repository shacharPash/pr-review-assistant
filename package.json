{
  "name": "pr-review-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bash bin/setup.sh",
    "install-agent": "bash bin/install-agent.sh",
    "uninstall-agent": "bash bin/uninstall-agent.sh",
    "dev": "tsx watch --env-file-if-exists=.env --ignore '**/vite.config.ts.timestamp-*' --ignore '**/dist/**' --ignore '**/client/**' server/index.ts",
    "start": "npm run setup && npm run serve",
    "build": "tsc -b && node bin/third-party-notices.mjs && vite build",
    "serve": "npm run build && NODE_ENV=production node --env-file-if-exists=.env dist/server/index.js",
    "make-launcher": "bash bin/make-launcher.sh",
    "autostart-on": "bash bin/autostart.sh on",
    "autostart-off": "bash bin/autostart.sh off",
    "preview": "NODE_ENV=production node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "express": "^4.22.3",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "open": "^10.1.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "jsdom": "^30.0.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.15"
    }
  }
}
